// DAZ Studio version 4.5.0.53 filetype DAZ Script

//

// NOVA AEIOU + SPEECH MOUTH ASSET BUILDER - v26 (full-head render, hair preserved, visibility-safe)

// DAZ Studio 4.24 / NVIDIA Iray

//

// v19 GOAL:

// Build a compositor-ready 2.5D asset set from the WORKING v8 renderer.

//

// IMPORTANT:

// - Keeps the proven DirectToFile + RenderMgr.doRender() path from v8.

// - Keeps CPU/GPU scheduling restore and facial-state restore.

// - Keeps the final completion/exit section.

// - Does NOT save or modify the DUF scene.

// - Renders PNGs with the Iray environment/dome/ground disabled when those

//   properties are available, so the outputs are alpha-ready for compositing.

// - Separates base, eyes, eyebrows, mouth/face-deformation, and expressions.

//

// NOTE:

// Genesis facial morphs live on the head geometry. DAZ's public canvas/node-list

// API can isolate nodes, but it cannot isolate individual morph regions on one

// head mesh. Therefore v10 deliberately keeps the actual facial deformation

// source renders intact instead of pretending a mouth PNG alone contains the

// surrounding skin deformation. The app can later use masks/difference or a

// second-stage crop/compositor on these source plates.

//

// The script is intentionally conservative: first make reliable, alpha-ready

// source passes; then the ma9icAI compositor can combine them in real time.

function novaMain() {

    // ============================================================

    // CONFIG

    // ============================================================

    // PRODUCTION MODE: one facial pass only.

    // This is deliberately NOT a production render. It exists so we can verify

    // visibility isolation/camera/material behavior in seconds instead of

    // waiting through the full 2.5D batch.

    var WIDTH = 2048;

    var HEIGHT = 2048;

    var PRODUCTION_MAX_SAMPLES = 48;

    var PRODUCTION_MAX_TIME = 30.0;

    var PRODUCTION_RENDER_ALL_EYE_STATES = true;


    // DAZ morph properties use normalized values (0.0 to 1.0).
    // Percentage labels are used only for output filenames.
    var VISEME_STRENGTH = 1.0;
    var EYE_STRENGTH = 1.0;
    var BROW_STRENGTH = 1.0;
    var EXPRESSION_STRENGTH = 1.0;

    // PRODUCTION: render ONLY one center-eye facial isolation pass.

    var DO_BASE = false;

    var DO_EYES = false;

    var DO_BLINKS = false;

    var DO_EYEBROWS = false;

    var DO_MOUTH = true;

    var DO_FACE_DEFORM = false;

    var DO_EXPRESSIONS = false;

    // Keep false. This can create a large number of source renders.

    var DO_VISEME_EYE_MATRIX = false;

    // CPU contribution target. Keep the proven v8 behavior.

    var CPU_LOAD_FRACTION = 0.50;

    // ============================================================

    // SCRIPT LOAD TEST

    // ============================================================

    App.writeToLog("Nova v26 AEIOU + SPEECH script loaded (ToulouseHR parent-chain fix + Exit Script).", true);

    // ============================================================

    // HELPERS

    // ============================================================

    function info(s) {

        MessageBox.information(s, "Nova AEIOU + SPEECH v26", "&OK");

    }

    function fail(s) {

        MessageBox.critical(s, "Nova AEIOU + SPEECH v26", "&OK");

    }

    function warn(s) {

        MessageBox.warning(s, "Nova AEIOU + SPEECH v26", "&OK");

    }

    function findPropertyByLabel(properties, label) {

        var target = String(label).toLowerCase();

        for (var i = 0; i < properties.length; i += 1) {

            try {

                if (String(properties[i].getLabel()).toLowerCase() == target) {

                    return properties[i];

                }

            } catch (e) {}

        }

        return null;

    }

    function findPropertyContains(properties, text) {

        var target = String(text).toLowerCase();

        for (var i = 0; i < properties.length; i += 1) {

            try {

                if (String(properties[i].getLabel()).toLowerCase().indexOf(target) >= 0) {

                    return properties[i];

                }

            } catch (e) {}

        }

        return null;

    }

    function getPropertyValue(p) {

        try {

            return p.getValue();

        } catch (e) {

            return 0;

        }

    }

    function setPropertyValue(p, value) {

        if (!p) {

            return;

        }

        try {

            p.setValue(value);

        } catch (e) {}

    }

    function safeFileName(s) {

        return String(s).replace(/[\\\/:*?"<>|]/g, "_");

    }

    function ensureDir(parentPath, name) {

        var path = parentPath + "/" + name;

        var dir = new DzDir(path);

        if (!dir.exists()) {

            var parent = new DzDir(parentPath);

            if (!parent.exists()) {

                return null;

            }

            try {

                parent.mkdir(name);

            } catch (e) {

                return null;

            }

        }

        if (!dir.exists()) {

            return null;

        }

        return dir;

    }

    function getElementPropertiesDeep(element) {

        var result = [];

        if (!element) {

            return result;

        }

        try {

            var tree = element.getPropertyGroups();

            if (tree && typeof tree.getAllProperties == "function") {

                result = tree.getAllProperties();

                if (result && result.length > 0) {

                    return result;

                }

            }

        } catch (eTree) {}

        try {

            result = element.getPropertyList();

        } catch (eList) {

            result = [];

        }

        return result;

    }

    function findElementPropertyContains(element, text) {

        return findPropertyContains(

            getElementPropertiesDeep(element),

            text

        );

    }

    function findElementPropertyByLabel(element, label) {

        return findPropertyByLabel(

            getElementPropertiesDeep(element),

            label

        );

    }

    // ============================================================

    // BATCH STATE

    // ============================================================

    var stopBatch = false;

    var rendered = 0;

    var failed = 0;

    // ============================================================

    // RENDER FUNCTIONS

    // ============================================================

    // Base uses the proven v8 RenderMgr.doRender() path.

    // Facial layers use DAZ's documented DzImageRenderHandler crop window so

    // Iray only writes the requested face region instead of a full 2048x2048

    // frame. This is the key performance change in v10.

    function forceHairHierarchyVisible(nodes, hairRoots) {
        var forced = 0;
        for (var ni = 0; ni < nodes.length; ni += 1) {
            var node = nodes[ni];
            if (nodeIsHairRelated(node, hairRoots)) {
                setNodeVisible(node, true);
                setRenderVisible(node, true);
                forced += 1;
            }
        }
        // Also enable every ancestor of each hair root: DAZ can suppress a visible
        // hair prop when an enclosing group/parent node is hidden.
        for (var ri = 0; ri < hairRoots.length; ri += 1) {
            var cur = hairRoots[ri];
            var guard = 0;
            while (cur && guard < 128) {
                setNodeVisible(cur, true);
                setRenderVisible(cur, true);
                cur = parentOf(cur);
                guard += 1;
            }
        }
        App.writeToLog("Nova v26 HAIR: forced normal+render visibility on " + forced + " related nodes plus parent chains.", true);
        return forced;
    }

    function isolateCharacterRenderNodes() {
        // Intentionally no longer hides every node. Earlier all-node isolation
        // produced mouth-only/bald layers. Keep the scene's original full geometry
        // visibility and only ensure the known hair asset is visible.
        saveRenderVisibility();
        var nodes = Scene.getNodeList();
        var hairRoots = collectHairRoots(nodes);
        if (!hairRoots || hairRoots.length === 0) {
            App.writeToLog("Nova v26 HAIR WARNING: no ToulouseHR/hair node matched; preserving the whole scene and not hiding any nodes.", true);
            return;
        }
        forceHairHierarchyVisible(nodes, hairRoots);
        App.writeToLog("Nova v26: full scene/head visibility preserved for character render; no blanket hide pass.", true);
    }

    function renderFullFile(filePath) {
        var output = String(filePath).replace(/\\/g, "/");
        try {
            isolateCharacterRenderNodes();
            try { renderer.setRenderCamera(camera); } catch (eCamera) {}
            renderOptions.imageSize = new Size(WIDTH, HEIGHT);
            renderOptions.isAspectConstrained = true;
            renderOptions.setAspectRatio(1, 1);
            renderOptions.isCurrentFrameRender = true;
            renderOptions.renderImgToId = DzRenderOptions.DirectToFile;
            renderOptions.renderImgFilename = output;
            App.writeToLog("Nova v26 SPEECH: CHARACTER render -> " + output + " size=" + WIDTH + "x" + HEIGHT, true);
            var result = renderMgr.doRender(renderOptions);
            App.writeToLog("Nova v26 SPEECH: CHARACTER render returned " + result, true);
            return result;
        } finally { restoreRenderVisibility(); }
    }

    // ============================================================

    // FACIAL RENDER ISOLATION

    // ============================================================

    // v19 does NOT use renderer.customRender() for Genesis 9 facial layers.

    // v12 proved that isolated customRender(head) can produce blank/deformed

    // Iray plates in this scene. Instead we use DAZ's normal render pipeline,

    // but temporarily hide everything that is not part of the moving face.

    // This preserves the exact Genesis 9 scene/shaders/camera behavior while

    // removing the expensive torso/body/environment geometry from the facial

    // passes. Hair remains visible in every layer by design.

    var savedRenderVisibility = null;

    var facialIsolationReady = false;

    function isFacialNode(node) {

        if (!node) { return false; }

        var label = "";

        try { label = String(node.getLabel()).toLowerCase(); } catch (eLabel) {}

        var keywords = [

            "head", "face", "eye", "eyes", "eyebrow", "brow",

            "eyelash", "lash", "cornea", "iris", "pupil", "sclera",

            "tear", "lacrimal", "mouth", "lip", "jaw", "teeth", "tooth",

            "tongue", "gum", "gums"

        ];

        for (var ki = 0; ki < keywords.length; ki += 1) {

            if (label.indexOf(keywords[ki]) >= 0) { return true; }

        }

        return false;

    }

    // v19: hair is NOT a separate plate anymore. Every final layer is a

    // complete 2048x2048 render with the actual Nova hair visible. We only

    // use label/descendant detection here so hair-related nodes survive the

    // facial isolation pass without bringing the torso/body/environment back.

    function isHairLabelNode(node) {

        if (!node) { return false; }

        // DAZ assets do not always expose the hair product name through
        // getLabel(); check both the scene label and internal node name.
        var labels = [];
        try { labels.push(String(node.getLabel()).toLowerCase()); } catch (eHairLabel) {}
        try { labels.push(String(node.getName()).toLowerCase()); } catch (eHairName) {}

        // Some conforming hair items are represented by an object attached to
        // a scene node. Include its name/label when the DAZ build exposes it.
        try {
            var hairObject = node.getObject();
            if (hairObject) {
                try { labels.push(String(hairObject.getLabel()).toLowerCase()); } catch (eHairObjectLabel) {}
                try { labels.push(String(hairObject.getName()).toLowerCase()); } catch (eHairObjectName) {}
            }
        } catch (eHairObject) {}

        for (var hli = 0; hli < labels.length; hli += 1) {
            var label = labels[hli];
            if (label.indexOf("hair") >= 0 ||
                label.indexOf("hairstyle") >= 0 ||
                label.indexOf("haircap") >= 0 ||
                label.indexOf("scalp hair") >= 0 ||
                label === "toulousehr" ||
                label.indexOf("toulouse hr") >= 0 ||
                label.indexOf("toulousehr") >= 0) {
                return true;
            }
        }
        return false;

    }

    // Find the installed hair prop by both its DAZ label and internal object/node
    // names. In this scene the item is labelled "ToulouseHR"; the word "hair"
    // does not appear in its label. Keep it and its whole hierarchy during passes.
    function collectHairRoots(nodes) {
        var roots = [];
        for (var hi = 0; hi < nodes.length; hi += 1) {
            if (isHairLabelNode(nodes[hi])) {
                var duplicate = false;
                for (var ri = 0; ri < roots.length; ri += 1) {
                    if (roots[ri] === nodes[hi]) { duplicate = true; break; }
                }
                if (!duplicate) { roots.push(nodes[hi]); }
            }
        }
        // Additional exact lookup helps if this DAZ build doesn't enumerate the
        // node's internal object label in the normal scene node list.
        try {
            var exact = Scene.findNodeByLabel("ToulouseHR");
            if (exact) {
                var hasExact = false;
                for (var ex = 0; ex < roots.length; ex += 1) {
                    if (roots[ex] === exact) { hasExact = true; break; }
                }
                if (!hasExact) { roots.push(exact); }
            }
        } catch (eExactHair) {}
        return roots;
    }

    function parentOf(node) {
        if (!node) { return null; }
        try { return node.getNodeParent(); } catch (eParent) {}
        try { return node.getParent(); } catch (eParent2) {}
        return null;
    }

    function sameOrParentChainContains(node, expected) {
        var cur = node;
        var guard = 0;
        while (cur && guard < 256) {
            if (cur === expected) { return true; }
            cur = parentOf(cur);
            guard += 1;
        }
        return false;
    }

    function nodeIsHairRelated(node, hairRoots) {
        if (!node || !hairRoots || hairRoots.length === 0) { return false; }
        if (isHairLabelNode(node)) { return true; }
        for (var hri = 0; hri < hairRoots.length; hri += 1) {
            var root = hairRoots[hri];
            if (!root) { continue; }
            // Do not rely on isNodeDescendantOf's optional arguments: walk the
            // actual DAZ parent chain both ways so parents controlling visibility
            // and all child geometry are kept as well.
            if (sameOrParentChainContains(node, root) ||
                sameOrParentChainContains(root, node)) {
                return true;
            }
        }
        return false;
    }

    function saveRenderVisibility() {
        // Take a fresh snapshot for each render; don't reuse a stale batch-wide snapshot.
        if (savedRenderVisibility) { return; }
        savedRenderVisibility = [];
        var nodes = Scene.getNodeList();
        for (var i = 0; i < nodes.length; i += 1) {
            var node = nodes[i];
            if (!node) { continue; }
            var state = { node: node, visibleInRender: null, visible: null };
            try { state.visibleInRender = node.isVisibleInRender(); } catch (eSaveRender) {}
            try { state.visible = node.isVisible(); } catch (eSaveVisible) {}
            if (state.visibleInRender !== null || state.visible !== null) { savedRenderVisibility.push(state); }
        }
        App.writeToLog("Nova v26: saved visibility state for " + savedRenderVisibility.length + " scene nodes.", true);
    }

    function setRenderVisible(node, value) {

        if (!node) { return; }

        try { node.setVisibleInRender(value); } catch (eSetVis) {}

    }

    function setNodeVisible(node, value) {
        if (!node) { return; }
        try { node.setVisible(value); } catch (eSetVisible) {}
    }

    function restoreRenderVisibility() {
        if (!savedRenderVisibility) { return; }
        for (var i = 0; i < savedRenderVisibility.length; i += 1) {
            var item = savedRenderVisibility[i];
            try {
                if (item.visible !== null) { item.node.setVisible(item.visible); }
            } catch (eRestoreVisible) {}
            try {
                if (item.visibleInRender !== null) { item.node.setVisibleInRender(item.visibleInRender); }
            } catch (eRestoreRender) {}
        }
        App.writeToLog("Nova v26: restored original normal/render visibility.", true);
        savedRenderVisibility = null;
    }

    function isolateFacialRenderNodes() {
        // Do NOT blanket-hide the scene or isolate the Head bone. The Genesis 9
        // face is part of the full figure mesh, and ToulouseHR is a separate prop;
        // the old visibility isolation suppressed hair and reduced the output to
        // a mouth-region plate. We now render the full consistent head/shoulder
        // frame at every phoneme, leaving masks/compositing to the next stage.
        saveRenderVisibility();
        var nodes = Scene.getNodeList();
        var hairRoots = collectHairRoots(nodes);
        App.writeToLog("Nova v26 HAIR CHECK: matched hair/ToulouseHR roots=" + hairRoots.length, true);
        for (var ri = 0; ri < hairRoots.length; ri += 1) {
            var root = hairRoots[ri];
            var name = "(unnamed hair root)";
            try { name = String(root.getLabel()); } catch (eRootLabel) {
                try { name = String(root.getName()); } catch (eRootName) {}
            }
            App.writeToLog("Nova v26 HAIR CHECK: root=" + name, true);
        }
        if (hairRoots.length > 0) { forceHairHierarchyVisible(nodes, hairRoots); }
        else {
            App.writeToLog("Nova v26 HAIR WARNING: root not resolved. No nodes are hidden; scene's original visibility is retained.", true);
        }
        // Re-enable the known figure/head anchors without hiding other figure
        // geometry. The normal render pipeline is used, not customRender(head).
        setNodeVisible(genesis, true);
        setRenderVisible(genesis, true);
        setNodeVisible(head, true);
        setRenderVisible(head, true);
        App.writeToLog("Nova v26: full-scene visibility retained; no body/head/face nodes were blanket-hidden.", true);
        facialIsolationReady = true;
    }

    function renderFacialLayer(filePath) {

        var output = String(filePath).replace(/\\/g, "/");

        try {

            isolateFacialRenderNodes();

            // Use the proven normal Iray render path, only smaller. Same camera,

            // same Genesis 9 geometry, same materials, same lights. This avoids

            // customRender() and avoids crop coordinates entirely.

            try { renderer.setRenderCamera(camera); } catch (eCamera) {}

            renderOptions.imageSize = new Size(WIDTH, HEIGHT);

            renderOptions.isAspectConstrained = true;

            renderOptions.setAspectRatio(1, 1);

            renderOptions.isCurrentFrameRender = true;

            renderOptions.renderImgToId = DzRenderOptions.DirectToFile;

            renderOptions.renderImgFilename = output;

            App.writeToLog(

                "Nova v26 AEIOU + SPEECH: FACIAL-ISOLATED render -> " +

                output + " size=" + WIDTH + "x" + HEIGHT,

                true

            );

            var result = renderMgr.doRender(renderOptions);

            App.writeToLog(

                "Nova v26 AEIOU + SPEECH: full-head render returned " + result,

                true

            );

            if (!result) {

                throw new Error("Facial-isolated Iray render returned false.");

            }

            return true;

        } finally {

            restoreRenderVisibility();

            facialIsolationReady = false;

        }

    }

    function propertyLabel(prop) {
        try { return String(prop.getLabel()).toLowerCase(); } catch (eLabel) { return ""; }
    }

    function findDriverByAnyWords(list, words) {
        for (var i = 0; i < list.length; i += 1) {
            var label = propertyLabel(list[i]);
            for (var w = 0; w < words.length; w += 1) { if (label.indexOf(words[w]) >= 0) { return list[i]; } }
        }
        return null;
    }

    function renderStrengthSeries(dir, stem, prop, strengths, headOnly) {
        if (!prop) { return; }
        for (var si = 0; si < strengths.length && !stopBatch; si += 1) {
            resetFace();
            // Strength arrays are percentage labels; DAZ morphs use 0.0-1.0.
            var normalizedStrength = Number(strengths[si]) / 100.0;
            setPropertyValue(prop, normalizedStrength);
            doOne(dir.path() + "/" + stem + "_" + String(strengths[si]) + ".png", headOnly !== false);
        }
    }

    function doOne(filePath, headOnly) {

        if (stopBatch) { return false; }

        try {

            var ok = headOnly ? renderFacialLayer(filePath) : renderFullFile(filePath);

            if (ok) { rendered += 1; }

            else { failed += 1; stopBatch = true; }

            return ok;

        } catch (err) {

            failed += 1;

            stopBatch = true;

            MessageBox.warning(

                "A render failed:\n\n" + String(err) +

                "\n\nOutput:\n" + filePath,

                "Nova Render Warning", "&OK"

            );

            return false;

        }

    }

    // ============================================================

    // FIND SCENE / CAMERA / FIGURE

    // ============================================================

    // Prefer the active viewport camera (the current scene uses Camera 1 [Front]).
    // This matches the viewport that successfully framed the complete Nova head.
    var camera = null;
    try {
        var viewportMgrForCamera = MainWindow.getViewportMgr();
        var activeViewportForCamera = viewportMgrForCamera.getActiveViewport();
        var active3DForCamera = activeViewportForCamera ? activeViewportForCamera.get3DViewport() : null;
        if (active3DForCamera) { camera = active3DForCamera.getCamera(); }
    } catch (eActiveViewportCamera) {}

    if (!camera) {
        try { camera = Scene.findCameraByLabel("Nova_Camera"); } catch (eCameraFind) {}
    }
    if (!camera) {
        try {
            var cameras = Scene.getCameraList();
            if (cameras && cameras.length > 0) { camera = cameras[0]; }
        } catch (eCameras) {}
    }

    if (!camera) {

        fail("No camera was found in the scene.");

        return;

    }

    var genesis = Scene.findNodeByLabel("Genesis 9");

    if (!genesis) {

        genesis = Scene.getPrimarySelection();

    }

    if (!genesis) {

        fail(

            "Genesis 9 was not found.\n\n" +

            "Select the Genesis 9 figure and run the script again."

        );

        return;

    }

    var head = genesis.findNodeChildByLabel("Head", true);

    if (!head) {

        fail("Genesis 9 Head was not found.");

        return;

    }

    // ============================================================

    // RENDER MANAGER

    // ============================================================

    var renderMgr = App.getRenderMgr();

    if (!renderMgr) {

        fail("DAZ Render Manager was not available.");

        return;

    }

    var renderer = renderMgr.getActiveRenderer();

    if (!renderer) {

        fail("No active renderer was available.");

        return;

    }

    var renderOptions = renderMgr.getRenderOptions();

    if (!renderOptions) {

        fail("DAZ Render Options were not available.");

        return;

    }

    // ============================================================

    // IRAY CPU/GPU - SAME RESTORE LOGIC AS v8

    // ============================================================

    var iraySchedulingEnabled = false;

    var oldCPULoadLimit = 0;

    var oldGPULoadLimit = 0;

    var oldAllowCPUFallback = false;

    var oldCPUThreadAffinity = false;

    var newCPULoadLimit = 0;

    if (

        typeof renderer.getCPULoadLimit == "function" &&

        typeof renderer.setCPULoadLimit == "function"

    ) {

        try {

            oldCPULoadLimit = renderer.getCPULoadLimit();

            newCPULoadLimit = oldCPULoadLimit * CPU_LOAD_FRACTION;

            if (newCPULoadLimit < 1.0) {

                newCPULoadLimit = 1.0;

            }

            renderer.setCPULoadLimit(newCPULoadLimit);

            iraySchedulingEnabled = true;

            if (

                typeof renderer.getGPULoadLimit == "function" &&

                typeof renderer.setGPULoadLimit == "function"

            ) {

                oldGPULoadLimit = renderer.getGPULoadLimit();

                renderer.setGPULoadLimit(oldGPULoadLimit);

            }

            if (

                typeof renderer.getAllowCPUFallback == "function" &&

                typeof renderer.setAllowCPUFallback == "function"

            ) {

                oldAllowCPUFallback = renderer.getAllowCPUFallback();

                renderer.setAllowCPUFallback(true);

            }

            if (

                typeof renderer.getCPUThreadAffinityEnabled == "function" &&

                typeof renderer.setCPUThreadAffinityEnabled == "function"

            ) {

                oldCPUThreadAffinity = renderer.getCPUThreadAffinityEnabled();

            }

        } catch (eIray) {

            fail(

                "Could not configure Iray CPU scheduling.\n\n" +

                String(eIray)

            );

            return;

        }

    } else {

        fail(

            "The active renderer does not expose the Iray CPU scheduling API.\n\n" +

            "Make sure NVIDIA Iray is active."

        );

        return;

    }

    // ============================================================

    // SCENE PATH / OUTPUT FOLDERS

    // ============================================================

    var sceneFile = Scene.getFilename();

    if (!sceneFile || String(sceneFile).length < 1) {

        fail(

            "Nova_Master.duf has not been saved.\n\n" +

            "Save the scene first, then run this script."

        );

        return;

    }

    var scenePath = String(sceneFile).replace(/\\/g, "/");

    var slashPos = scenePath.lastIndexOf("/");

    if (slashPos <= 2) {

        fail(

            "Could not determine the scene folder from:\n\n" +

            scenePath

        );

        return;

    }

    var basePath = scenePath.substring(0, slashPos);

    if (!/^[A-Za-z]:\//.test(basePath)) {

        fail(

            "DAZ returned a non-absolute scene path:\n\n" +

            basePath +

            "\n\nScene filename:\n" +

            scenePath

        );

        return;

    }

    // ALWAYS use a fresh output folder so v9/v10/v11/v12/v13/v14 images are never overwritten.

    // If Nova_AEIOU_SPEECH_v26 already exists, automatically

    // create _run2, _run3, etc. No DAZ "Replace existing file?" prompts.

    var rootName = "Nova_AEIOU_SPEECH_v26";

    var rootPath = basePath + "/" + rootName;

    var runNumber = 1;

    while (new DzDir(rootPath).exists()) {

        runNumber++;

        rootName = "Nova_AEIOU_SPEECH_v26_run" + runNumber;

        rootPath = basePath + "/" + rootName;

    }

    var root = ensureDir(basePath, rootName);

    if (!root) {

        fail(

            "Could not create the Nova v26 AEIOU + SPEECH output folder:\n\n" +

            rootPath

        );

        return;

    }

    var baseDir = ensureDir(rootPath, "base");
    var eyesDir = ensureDir(rootPath, "eyes");
    var blinksDir = ensureDir(rootPath, "blinks");
    var eyebrowsDir = ensureDir(rootPath, "eyebrows");
    var mouthDir = ensureDir(rootPath, "mouth");
    var vowelsDir = ensureDir(rootPath, "vowels");
    var speechDir = ensureDir(rootPath, "speech");
    var faceDeformDir = ensureDir(rootPath, "face_deform");
    var expressionsDir = ensureDir(rootPath, "expressions");
    var emotionsDir = ensureDir(rootPath, "emotions");
    var reactionsDir = ensureDir(rootPath, "reactions");
    var idleDir = ensureDir(rootPath, "idle_listening");
    var transitionsDir = ensureDir(rootPath, "transitions");
    var metadataDir = ensureDir(rootPath, "metadata");

    if (
        !baseDir ||
        !eyesDir ||
        !blinksDir ||
        !eyebrowsDir ||
        !mouthDir ||
        !vowelsDir ||
        !speechDir ||
        !faceDeformDir ||
        !expressionsDir ||
        !emotionsDir ||
        !reactionsDir ||
        !idleDir ||
        !transitionsDir ||
        !metadataDir
    ) {

        fail(

            "Could not create one or more Nova v26 AEIOU + SPEECH output folders.\n\n" +

            "Root:\n" + root.path()

        );

        return;

    }

    // ============================================================

    // IRAY ALPHA-READY SETTINGS

    // ============================================================

    // IMPORTANT: Render Settings properties are owned by the renderer's

    // render-element tree. They are NOT reliably exposed through a generic

    // renderer property-holder. DAZ's official "Render Settings - Find

    // Property" sample searches getRenderElementObjects(), so v10 uses that

    // same route here.

    function getRenderElementProperties(element) {

        var result = [];

        if (!element) {

            return result;

        }

        try {

            var tree = element.getPropertyGroups();

            if (tree) {

                if (App.version64 >= 0x0004000900040065 &&

                    typeof tree.getAllProperties == "function") {

                    result = tree.getAllProperties();

                } else if (typeof tree.getFirstChild == "function") {

                    result = getElementPropertiesDeep(element);

                }

            }

        } catch (eRenderElementProps) {

            result = [];

        }

        return result;

    }

    function findRendererSettingByLabel(label) {

        var target = String(label).toLowerCase();

        var elements = [];

        try {

            elements = renderMgr.getRenderElementObjects();

        } catch (eElements) {

            elements = [];

        }

        for (var ei = 0; ei < elements.length; ei += 1) {

            var props = getRenderElementProperties(elements[ei]);

            for (var pi = 0; pi < props.length; pi += 1) {

                try {

                    if (String(props[pi].getLabel()).toLowerCase() == target) {

                        return props[pi];

                    }

                } catch (ePropLabel) {}

            }

            // Some render elements expose child elements. Search those too.

            try {

                for (var ci = 0; ci < elements[ei].getNumElementChildren(); ci += 1) {

                    var child = elements[ei].getElementChild(ci);

                    var childProps = getRenderElementProperties(child);

                    for (var cpi = 0; cpi < childProps.length; cpi += 1) {

                        try {

                            if (String(childProps[cpi].getLabel()).toLowerCase() == target) {

                                return childProps[cpi];

                            }

                        } catch (eChildLabel) {}

                    }

                }

            } catch (eChildren) {}

        }

        return null;

    }

    var drawDome = findRendererSettingByLabel("Draw Dome");

    var drawGround = findRendererSettingByLabel("Draw Ground");

    var oldDrawDome = null;

    var oldDrawGround = null;

    var alphaReady = false;

    if (drawDome) {

        oldDrawDome = getPropertyValue(drawDome);

        setPropertyValue(drawDome, 0);

    }

    if (drawGround) {

        oldDrawGround = getPropertyValue(drawGround);

        setPropertyValue(drawGround, 0);

    }

    // A transparent PNG requires the visible dome/ground to be disabled.

    // DAZ documents Draw Dome and Draw Ground as the controls for whether

    // those environment surfaces are rendered. The environment can still

    // provide illumination; we are only removing the visible background.

    alphaReady = !!drawDome && !!drawGround;

    App.writeToLog(

        "Nova v26 AEIOU + SPEECH alpha setup via Render Settings: Draw Dome found=" +

        (!!drawDome) +

        ", Draw Ground found=" +

        (!!drawGround) +

        ", alpha-ready=" +

        alphaReady,

        true

    );

    // ============================================================

    // FAST IRAY QUALITY OVERRIDE

    // ============================================================

    // DAZ exposes renderer settings such as Max Samples through the render

    // element property tree. We temporarily lower them for this production

    // pass and restore the user's original values in the final cleanup.

    var productionMaxSamplesProp = findRendererSettingByLabel("Max Samples");

    var productionMaxTimeProp = findRendererSettingByLabel("Max Time");

    var oldProductionMaxSamples = null;

    var oldProductionMaxTime = null;

    if (productionMaxSamplesProp) {

        oldProductionMaxSamples = getPropertyValue(productionMaxSamplesProp);

        setPropertyValue(productionMaxSamplesProp, PRODUCTION_MAX_SAMPLES);

    }

    if (productionMaxTimeProp) {

        oldProductionMaxTime = getPropertyValue(productionMaxTimeProp);

        setPropertyValue(productionMaxTimeProp, PRODUCTION_MAX_TIME);

    }

    App.writeToLog(

        "Nova v26 AEIOU + SPEECH quality: Max Samples=" +

        (!!productionMaxSamplesProp ? PRODUCTION_MAX_SAMPLES : "not found") +

        ", Max Time=" +

        (!!productionMaxTimeProp ? PRODUCTION_MAX_TIME : "not found"),

        true

    );

    // ============================================================

    // FACIAL PROPERTIES

    // ============================================================

    // Genesis morph controls are commonly stored on the figure root, not the
    // Head scene node. Search both property trees; the earlier version only
    // searched Head and missed the vowel/speech controls on Laura for Genesis 9.
    var properties = getElementPropertiesDeep(genesis);
    function appendUniqueProperties(source) {
        if (!source) { return; }
        for (var qi = 0; qi < source.length; qi += 1) {
            var knownProperty = false;
            for (var qj = 0; qj < properties.length; qj += 1) {
                if (properties[qj] === source[qi]) { knownProperty = true; break; }
            }
            if (!knownProperty) { properties.push(source[qi]); }
        }
    }
    appendUniqueProperties(getElementPropertiesDeep(head));
    // On Genesis 9, mouth/tongue controls may be attached to separate scene
    // nodes. Include those properties too, instead of searching only the head.
    var propertyNodes = Scene.getNodeList();
    var extraMouthNodes = 0;
    for (var qn = 0; qn < propertyNodes.length; qn += 1) {
        var propertyNode = propertyNodes[qn];
        if (!propertyNode || propertyNode === genesis || propertyNode === head) { continue; }
        var propertyNodeLabel = "";
        var propertyNodeName = "";
        try { propertyNodeLabel = String(propertyNode.getLabel()).toLowerCase(); } catch (ePNL) {}
        try { propertyNodeName = String(propertyNode.getName()).toLowerCase(); } catch (ePNN) {}
        var mouthNodeRelevant = /(mouth|tongue|jaw|oral)/.test(propertyNodeLabel + " " + propertyNodeName);
        if (mouthNodeRelevant) {
            appendUniqueProperties(getElementPropertiesDeep(propertyNode));
            extraMouthNodes += 1;
        }
    }
    App.writeToLog("Nova v26 property search: figure + head + " + extraMouthNodes + " mouth/tongue nodes = " + properties.length + " unique properties", true);

    var eyeSide = findPropertyByLabel(

        properties,

        "Eye Look Side-Side"

    );

    var eyeUpDown = findPropertyByLabel(

        properties,

        "Eye Look Up-Down"

    );

    var eyeBlink = findPropertyByLabel(

        properties,

        "Eye Blink"

    );

    if (!eyeSide) {

        eyeSide = findPropertyContains(

            properties,

            "Eye Look Side-Side"

        );

    }

    if (!eyeUpDown) {

        eyeUpDown = findPropertyContains(

            properties,

            "Eye Look Up-Down"

        );

    }

    if (!eyeBlink) {

        eyeBlink = findPropertyContains(

            properties,

            "Eye Blink"

        );

    }

    // Visemes are the mouth-shape drivers.

    var visemes = [];

    for (var p = 0; p < properties.length; p += 1) {

        var label = "";

        try {

            label = properties[p].getLabel();

        } catch (eLabel) {}

        if (

            String(label).toLowerCase().indexOf("viseme") >= 0

        ) {

            visemes.push(properties[p]);

        }

    }

    // If this Genesis 9 setup has no explicit Viseme controls, discover a

    // small set of direct mouth/lip/jaw drivers instead. v9 found zero

    // visemes, so this is how v10 gets real mouth movement without guessing

    // at a fixed naming scheme.

    var mouthDrivers = [];

    var mouthKeywords = ["mouth", "lip", "jaw", "phoneme", "viseme"];

    for (var mp = 0; mp < properties.length; mp += 1) {

        var mouthLabel = "";

        try { mouthLabel = String(properties[mp].getLabel()).toLowerCase(); } catch (eMouthLabel) {}

        var isMouth = false;

        for (var mk = 0; mk < mouthKeywords.length; mk += 1) {

            if (mouthLabel.indexOf(mouthKeywords[mk]) >= 0) { isMouth = true; break; }

        }

        var nonMorphControl = (
            mouthLabel.indexOf("visibility") >= 0 ||
            mouthLabel.indexOf("visible") >= 0 ||
            mouthLabel.indexOf("opacity") >= 0 ||
            mouthLabel.indexOf("texture") >= 0 ||
            mouthLabel.indexOf("material") >= 0 ||
            mouthLabel.indexOf("color") >= 0 ||
            mouthLabel.indexOf("surface") >= 0 ||
            mouthLabel.indexOf("enable") >= 0 ||
            mouthLabel.indexOf("lock") >= 0
        );

        if (isMouth && !nonMorphControl && mouthLabel.indexOf("brow") < 0) {

            var duplicateMouth = false;

            for (var md = 0; md < mouthDrivers.length; md += 1) {

                if (mouthDrivers[md] === properties[mp]) { duplicateMouth = true; break; }

            }

            if (!duplicateMouth) { mouthDrivers.push(properties[mp]); }

        }

    }

    // Search for eyebrow controls separately.

    var browProperties = [];

    var browKeywords = [

        "brow",

        "eyebrow",

        "eyebrow inner",

        "eyebrow outer"

    ];

    for (var bp = 0; bp < properties.length; bp += 1) {

        var browLabel = "";

        try {

            browLabel = String(properties[bp].getLabel()).toLowerCase();

        } catch (eBrowLabel) {}

        var isBrow = false;

        for (var bk = 0; bk < browKeywords.length; bk += 1) {

            if (browLabel.indexOf(browKeywords[bk]) >= 0) {

                isBrow = true;

                break;

            }

        }

        if (isBrow) {

            var alreadyBrow = false;

            for (var bd = 0; bd < browProperties.length; bd += 1) {

                if (browProperties[bd] === properties[bp]) {

                    alreadyBrow = true;

                    break;

                }

            }

            if (!alreadyBrow) {

                browProperties.push(properties[bp]);

            }

        }

    }

    // Common expression drivers. These are also used as face-deformation

    // source plates because the skin around the mouth/eyes follows these

    // morphs in the actual DAZ render.

    var expressionNames = [
        "smile", "frown", "angry", "surprised", "sad", "mouth open", "mouth wide",
        "cheek", "lip", "happy", "joy", "excited", "calm", "confused", "worried",
        "fear", "scared", "shocked", "thinking", "skeptical", "smirk", "annoyed",
        "disgust", "tired", "embarrassed", "laugh", "sneer", "concern", "focus",
        "squint", "relaxed"
    ];

    var expressions = [];

    for (var e = 0; e < expressionNames.length; e += 1) {

        var ep = findPropertyContains(

            properties,

            expressionNames[e]

        );

        if (ep) {

            var duplicateExpression = false;

            for (var ed = 0; ed < expressions.length; ed += 1) {

                if (expressions[ed].property === ep) {

                    duplicateExpression = true;

                    break;

                }

            }

            if (!duplicateExpression) {

                expressions.push({

                    name: safeFileName(expressionNames[e]),

                    property: ep

                });

            }

        }

    }

    // ============================================================

    // SAVE FACIAL STATE

    // ============================================================

    var savedProperties = [];

    var saveList = [];

    if (eyeSide) saveList.push(eyeSide);

    if (eyeUpDown) saveList.push(eyeUpDown);

    if (eyeBlink) saveList.push(eyeBlink);

    for (var sb = 0; sb < browProperties.length; sb += 1) {

        saveList.push(browProperties[sb]);

    }

    for (var sv = 0; sv < visemes.length; sv += 1) {

        saveList.push(visemes[sv]);

    }

    for (var sm = 0; sm < mouthDrivers.length; sm += 1) {

        saveList.push(mouthDrivers[sm]);

    }

    for (var se = 0; se < expressions.length; se += 1) {

        saveList.push(expressions[se].property);

    }

    for (var si = 0; si < saveList.length; si += 1) {

        var duplicate = false;

        for (var sj = 0; sj < savedProperties.length; sj += 1) {

            if (savedProperties[sj].property === saveList[si]) {

                duplicate = true;

                break;

            }

        }

        if (!duplicate) {

            savedProperties.push({

                property: saveList[si],

                value: getPropertyValue(saveList[si])

            });

        }

    }

    // ============================================================

    // SAVE RENDER SETTINGS

    // ============================================================

    var oldImageSize = renderOptions.imageSize;

    var oldCurrentFrame = renderOptions.isCurrentFrameRender;

    var oldRenderImgTarget = renderOptions.renderImgToId;

    var oldRenderImgFilename = renderOptions.renderImgFilename;

    var oldRenderType = renderOptions.renderType;

    // ============================================================

    // FACE RESET

    // ============================================================

    // Composite AEIOU/phoneme presets use several real morph controls together.
    // Track those controls separately so their original values are preserved too.
    var speechSupportProps = [];

    function rememberOriginalProperty(prop) {
        if (!prop) { return; }
        for (var rsi = 0; rsi < savedProperties.length; rsi += 1) {
            if (savedProperties[rsi].property === prop) { return; }
        }
        savedProperties.push({ property: prop, value: getPropertyValue(prop) });
    }

    function addSpeechSupportProperty(prop) {
        if (!prop) { return; }
        for (var ssi = 0; ssi < speechSupportProps.length; ssi += 1) {
            if (speechSupportProps[ssi] === prop) { return; }
        }
        speechSupportProps.push(prop);
        rememberOriginalProperty(prop);
    }

    function resetFace() {

        setPropertyValue(eyeSide, 0);

        setPropertyValue(eyeUpDown, 0);

        setPropertyValue(eyeBlink, 0);

        for (var i = 0; i < browProperties.length; i += 1) {

            setPropertyValue(browProperties[i], 0);

        }

        for (var v = 0; v < visemes.length; v += 1) {

            setPropertyValue(visemes[v], 0);

        }

        for (var m = 0; m < mouthDrivers.length; m += 1) {

            setPropertyValue(mouthDrivers[m], 0);

        }

        for (var sp = 0; sp < speechSupportProps.length; sp += 1) {

            setPropertyValue(speechSupportProps[sp], 0);

        }

        for (var x = 0; x < expressions.length; x += 1) {

            setPropertyValue(expressions[x].property, 0);

        }

    }

    // ============================================================
    // INTERACTIVE SPEECH SHAPE REVIEW
    // ============================================================

    function repaintSpeechPreview() {
        try { MainWindow.getViewportMgr().repaintActive3DViewport(); } catch (e1) {}
        try { MainWindow.repaintActive3DViewport(); } catch (e2) {}
    }

    // Small DAZ-native input dialog. Input is a percent, converted to DAZ's 0..1 value.
    function promptMouthStrength(label, defaultPercent) {
        var dlg = new DzBasicDialog();
        dlg.caption = "Adjust mouth shape: " + label;
        var dlgWidget = dlg.getWidget();
        try { dlgWidget.objectName = "NovaSpeechStrength_" + safeFileName(label).replace(/\s/g, "_"); } catch (eName) {}

        var labelWidget = new DzLabel(dlg);
        labelWidget.text = "Morph strength for " + label + " (0 to 100 percent):";
        dlg.addWidget(labelWidget);

        var valueEdit = new DzLineEdit(dlg);
        valueEdit.text = String(defaultPercent);
        try { valueEdit.setIntValidator(0, 100); } catch (eValidator) {}
        dlg.addWidget(valueEdit);

        dlg.setAcceptButtonText("Apply Strength");
        dlg.setCancelButtonText("Skip This Shape");
        dlg.showHelpButton(false);
        dlg.showApplyButton(false);
        try {
            var sizeHint = dlgWidget.minimumSizeHint;
            dlg.setFixedSize(sizeHint.width, sizeHint.height);
        } catch (eSize) {}

        if (!dlg.exec()) { return null; }
        var n = parseInt(String(valueEdit.text), 10);
        if (isNaN(n)) { return defaultPercent; }
        if (n < 0) { n = 0; }
        if (n > 100) { n = 100; }
        return n;
    }

    // Apply a preset made from real DAZ morphs. `percent` scales all preset
    // components together, preserving their relative weights while the user tunes it.
    function applySpeechTarget(target, percent) {
        resetFace();
        var scale = Number(percent) / 100.0;
        for (var ci = 0; ci < target.components.length; ci += 1) {
            var component = target.components[ci];
            setPropertyValue(component.property, (Number(component.weight) / 100.0) * scale);
        }
    }

    // Morph combination is applied to the live figure so it can be inspected before Iray.
    function reviewAndRenderTarget(target) {
        if (!target || !target.components || target.components.length === 0 || stopBatch) { return false; }
        var percent = 100;
        var action = 1;
        while (!stopBatch) {
            applySpeechTarget(target, percent);
            repaintSpeechPreview();
            var componentLines = [];
            for (var cli = 0; cli < target.components.length; cli += 1) {
                var c = target.components[cli];
                var cLabel = "(unnamed morph)";
                try { cLabel = String(c.property.getLabel()); } catch (eCLabel) {}
                componentLines.push(cLabel + "  " + c.weight + "%");
            }

            action = MessageBox.question(
                "Shape: " + target.name + "\n\n" +
                "Morph combination:\n" + componentLines.join("\n") + "\n\n" +
                "Overall strength: " + percent + "%\n\n" +
                "Inspect Nova's mouth in the viewport behind this prompt.\n" +
                "Render PNG = save this 2048x2048 shape.\n" +
                "Adjust Strength = change the strength and inspect again.\n" +
                "Exit Script = stop the remaining batch and restore settings.\n\n" +
                "To skip only this shape, choose Adjust Strength and press Skip This Shape in the next dialog.",
                "Nova AEIOU + Speech Shape Review",
                "&Render PNG", "&Adjust Strength", "E&xit Script"
            );

            if (action === 0) {
                var didRender = doOne(target.path, true);
                resetFace();
                repaintSpeechPreview();
                return didRender;
            }
            if (action === 1) {
                var revised = promptMouthStrength(target.name, percent);
                if (revised === null) {
                    App.writeToLog("Nova v26: skipped after strength dialog cancelled: " + target.name, true);
                    resetFace();
                    repaintSpeechPreview();
                    return true;
                }
                percent = revised;
                continue;
            }

            // Exit this renderer's batch. Control flows through the shared cleanup section.
            stopBatch = true;
            App.writeToLog("Nova v26: user requested Exit Script at target: " + target.name, true);
            resetFace();
            repaintSpeechPreview();
            return false;
        }
        return false;
    }

    function normalizeSpeechLabel(speechLabel) {
        return String(speechLabel).toLowerCase().replace(/[^a-z0-9]+/g, " ").replace(/\s+/g, " ").replace(/^\s+|\s+$/g, "");
    }

    function aliasMatchesSpeechLabel(label, alias) {
        var normalizedLabel = normalizeSpeechLabel(label);
        var normalizedAlias = normalizeSpeechLabel(alias);
        if (!normalizedLabel || !normalizedAlias) { return false; }
        // Match complete word/phrase boundaries, never accidental substrings such as "th" in "mouth".
        return (" " + normalizedLabel + " ").indexOf(" " + normalizedAlias + " ") >= 0;
    }

    function findExplicitSpeechDriver(driverList, aliases) {
        for (var ai = 0; ai < aliases.length; ai += 1) {
            for (var di = 0; di < driverList.length; di += 1) {
                var candidateLabel = "";
                try { candidateLabel = String(driverList[di].getLabel()); } catch (eLabel) {}
                if (aliasMatchesSpeechLabel(candidateLabel, aliases[ai])) { return driverList[di]; }
            }
        }
        return null;
    }

    function alreadyTargeted(targetList, prop) {
        for (var ti = 0; ti < targetList.length; ti += 1) {
            if (targetList[ti].property === prop) { return true; }
        }
        return false;
    }

    function addSpeechTarget(targetList, category, stem, prop, outputDir) {
        if (!prop || alreadyTargeted(targetList, prop)) { return false; }
        targetList.push({
            category: category,
            name: category + " — " + propertyLabel(prop),
            property: prop,
            path: outputDir.path() + "/" + safeFileName(stem) + ".png"
        });
        return true;
    }

    // ============================================================
    // AEIOU + SPEECH PRESETS (COMPOSITES OF THE ACTUAL FIGURE MORPHS)
    // ============================================================
    // This character exposes basic mouth controls instead of named Viseme A/E/I/O/U
    // controls. Build editable combinations from those real controls, and render them
    // into separate `vowels` and `speech` folders. Do not label a lone unrelated morph
    // as a vowel. Every output is previewed and can be adjusted/skipped before rendering.

    function normalizeSpeechLabel(speechLabel) {
        return String(speechLabel).toLowerCase().replace(/[^a-z0-9]+/g, " ").replace(/\s+/g, " ").replace(/^\s+|\s+$/g, "");
    }

    function findCompositeProperty(aliases) {
        var best = null;
        var bestScore = -1;
        for (var pi = 0; pi < properties.length; pi += 1) {
            var prop = properties[pi];
            var rawLabel = "";
            try { rawLabel = String(prop.getLabel()); } catch (eRaw) {}
            var nLabel = normalizeSpeechLabel(rawLabel);
            if (!nLabel) { continue; }
            // Avoid one-sided controls when an overall mouth control is requested.
            var sidePenalty = (/(^| )(left|right)( |$)/).test(nLabel) ? 80 : 0;
            for (var ai = 0; ai < aliases.length; ai += 1) {
                var alias = normalizeSpeechLabel(aliases[ai]);
                if (!alias) { continue; }
                var score = -1;
                if (nLabel === alias) { score = 1000 + alias.length; }
                else if (nLabel.indexOf(" " + alias + " ") >= 0 || nLabel.indexOf(alias + " ") === 0 || nLabel.slice(-(alias.length + 1)) === " " + alias) {
                    score = 700 + alias.length;
                } else if (nLabel.indexOf(alias) >= 0) { score = 300 + alias.length; }
                if (score >= 0) {
                    score -= sidePenalty;
                    if (score > bestScore) { bestScore = score; best = prop; }
                }
            }
        }
        return best;
    }

    function addCompositeTarget(targetList, targetName, fileStem, directory, componentSpecs) {
        var components = [];
        var used = [];
        var missingRequired = [];
        for (var sci = 0; sci < componentSpecs.length; sci += 1) {
            var spec = componentSpecs[sci];
            var prop = findCompositeProperty(spec.aliases);
            if (!prop) {
                App.writeToLog("Nova v26 preset " + targetName + ": morph not found for component " + spec.key + (spec.required ? " (REQUIRED)" : " (optional)"), true);
                if (spec.required) { missingRequired.push(spec.key); }
                continue;
            }
            var already = false;
            for (var ui = 0; ui < used.length; ui += 1) { if (used[ui] === prop) { already = true; break; } }
            if (already) { continue; }
            used.push(prop);
            addSpeechSupportProperty(prop);
            components.push({ key: spec.key, property: prop, weight: spec.weight });
        }
        if (missingRequired.length > 0) {
            App.writeToLog("Nova v26 preset skipped because required articulation is unavailable: " + targetName + " missing " + missingRequired.join(", "), true);
            return false;
        }
        if (components.length > 0) {
            targetList.push({
                name: targetName,
                path: directory.path() + "/" + safeFileName(fileStem) + ".png",
                components: components
            });
            var detail = [];
            for (var di = 0; di < components.length; di += 1) {
                var detailLabel = "morph";
                try { detailLabel = String(components[di].property.getLabel()); } catch (eDetail) {}
                detail.push(detailLabel + "=" + components[di].weight + "%");
            }
            App.writeToLog("Nova v26 preset created: " + targetName + " -> " + detail.join("; "), true);
            return true;
        }
        App.writeToLog("Nova v26 preset skipped: no relevant component morphs found for " + targetName, true);
        return false;
    }

    info(
        "NOVA AEIOU + SPEECH MOUTH SHAPES v26\n\n" +
        "Will build A/E/I/O/U and eight speech families from Nova's actual available mouth morphs.\n" +
        "Vowels go in the `vowels` folder. Speech families go in `speech`.\n" +
        "Each shape gets a live viewport preview with Render / Adjust Strength / Skip.\n" +
        "Each PNG keeps the complete camera-framed Nova head and hair; background dome/ground are disabled.\n\n" +
        "Hair preservation now explicitly recognizes ToulouseHR. The scene will not be saved.\n\n" +
        "Click OK to begin."
    );

    var speechTargets = [];
    var vowelsMade = 0;
    var phonemesMade = 0;

    // Preset weights are initial working values, not claims of model-specific phoneme rigging.
    // Each one is reviewable and tunable before its PNG is committed.
    var vowelPresets = [
        {name:"Vowel A / ah", file:"vowel_A", parts:[
            {key:"open jaw/mouth", aliases:["mouth open", "jaw open", "open mouth", "jaw drop", "mouth drop"], weight:88, required:true},
            {key:"mouth stretch", aliases:["mouth stretch", "lip stretch", "stretch"], weight:28},
            {key:"upper lip lift", aliases:["mouth upper up", "upper lip up", "upper up"], weight:10}
        ]},
        {name:"Vowel E / eh", file:"vowel_E", parts:[
            {key:"smile widen", aliases:["mouth smile widen", "smile widen", "mouth wide", "wide mouth"], weight:62, required:true},
            {key:"mouth stretch", aliases:["mouth stretch", "lip stretch", "stretch"], weight:38},
            {key:"smile", aliases:["mouth smile", "smile"], weight:24},
            {key:"upper lip lift", aliases:["mouth upper up", "upper lip up", "upper up"], weight:12}
        ]},
        {name:"Vowel I / ih", file:"vowel_I", parts:[
            {key:"smile widen", aliases:["mouth smile widen", "smile widen", "mouth wide", "wide mouth"], weight:42, required:true},
            {key:"mouth stretch", aliases:["mouth stretch", "lip stretch", "stretch"], weight:22},
            {key:"smile", aliases:["mouth smile", "smile"], weight:15},
            {key:"upper lip lift", aliases:["mouth upper up", "upper lip up", "upper up"], weight:16}
        ]},
        {name:"Vowel O / oh", file:"vowel_O", parts:[
            {key:"pucker", aliases:["mouth pucker", "pucker"], weight:72, required:true},
            {key:"purse", aliases:["mouth purse", "purse lips", "purse"], weight:54},
            {key:"slight mouth opening", aliases:["mouth open", "jaw open", "open mouth"], weight:12}
        ]},
        {name:"Vowel U / oo", file:"vowel_U", parts:[
            {key:"pucker", aliases:["mouth pucker", "pucker"], weight:54, required:true},
            {key:"purse", aliases:["mouth purse", "purse lips", "purse"], weight:74, required:true},
            {key:"slight mouth opening", aliases:["mouth open", "jaw open", "open mouth"], weight:5}
        ]}
    ];

    for (var vi = 0; vi < vowelPresets.length; vi += 1) {
        if (addCompositeTarget(speechTargets, vowelPresets[vi].name, vowelPresets[vi].file, vowelsDir, vowelPresets[vi].parts)) {
            vowelsMade += 1;
        }
    }

    var phonemePresets = [
        {name:"Speech MBP / lips closed", file:"phoneme_MBP", parts:[
            {key:"lip press", aliases:["mouth press", "lip press", "lips pressed", "lip compression"], weight:88, required:true},
            {key:"sticky lip power", aliases:["mouth sticky power", "sticky power"], weight:18}
        ]},
        {name:"Speech FV / lower lip to teeth", file:"phoneme_FV", parts:[
            {key:"lower lip roll", aliases:["mouth roll lower", "lower lip roll", "roll lower"], weight:70, required:true},
            {key:"upper lip raise", aliases:["mouth upper up", "upper lip up", "upper up"], weight:30}
        ]},
        {name:"Speech L / tongue and open mouth", file:"phoneme_L", parts:[
            {key:"tongue forward", aliases:["tongue out", "tongue forward", "tongue protrusion", "tongue extended"], weight:45, required:true},
            {key:"mouth open", aliases:["mouth open", "jaw open", "open mouth"], weight:18},
            {key:"upper lip raise", aliases:["mouth upper up", "upper lip up", "upper up"], weight:18}
        ]},
        {name:"Speech TH / tongue forward", file:"phoneme_TH", parts:[
            {key:"tongue forward", aliases:["tongue out", "tongue forward", "tongue protrusion", "tongue extended"], weight:60, required:true},
            {key:"mouth open", aliases:["mouth open", "jaw open", "open mouth"], weight:18},
            {key:"lower lip relax", aliases:["mouth shrug lower", "lower lip down", "shrug lower"], weight:12}
        ]},
        {name:"Speech SZ / sibilant", file:"phoneme_SZ", parts:[
            {key:"smile widen", aliases:["mouth smile widen", "smile widen", "mouth wide", "wide mouth"], weight:64, required:true},
            {key:"mouth stretch", aliases:["mouth stretch", "lip stretch", "stretch"], weight:32}
        ]},
        {name:"Speech SH-CH-J / rounded fricative", file:"phoneme_SH_CH_J", parts:[
            {key:"pucker", aliases:["mouth pucker", "pucker"], weight:54},
            {key:"purse", aliases:["mouth purse", "purse lips", "purse"], weight:32},
            {key:"slight mouth opening", aliases:["mouth open", "jaw open", "open mouth"], weight:12}
        ]},
        {name:"Speech KG / back-of-mouth consonants", file:"phoneme_KG", parts:[
            {key:"mouth open", aliases:["mouth open", "jaw open", "open mouth"], weight:26, required:true},
            {key:"mouth stretch", aliases:["mouth stretch", "lip stretch", "stretch"], weight:12}
        ]},
        {name:"Speech TDN / tongue-tip consonants", file:"phoneme_TDN", parts:[
            {key:"tongue forward", aliases:["tongue out", "tongue forward", "tongue protrusion", "tongue extended"], weight:20, required:true},
            {key:"upper lip raise", aliases:["mouth upper up", "upper lip up", "upper up"], weight:24},
            {key:"mouth opening", aliases:["mouth open", "jaw open", "open mouth"], weight:12}
        ]}
    ];

    for (var pi2 = 0; pi2 < phonemePresets.length; pi2 += 1) {
        if (addCompositeTarget(speechTargets, phonemePresets[pi2].name, phonemePresets[pi2].file, speechDir, phonemePresets[pi2].parts)) {
            phonemesMade += 1;
        }
    }

    App.writeToLog(
        "Nova v26 composite totals: vowel presets=" + vowelsMade + "/5, speech families=" + phonemesMade + "/8, reviewable targets=" + speechTargets.length,
        true
    );

    // Hard guard: refuse a guaranteed bald batch rather than waste a render run.
    var verifiedHairRoots = collectHairRoots(Scene.getNodeList());
    if (!verifiedHairRoots || verifiedHairRoots.length === 0) {
        fail("ToulouseHR (or another hair node) was not detected in the scene tree. No renders were started, to avoid another bald batch. Check that ToulouseHR is present in the Scene pane.");
        stopBatch = true;
    }

    if (speechTargets.length === 0) {
        fail("No usable mouth morph controls were found to construct the vowel/speech presets. No renders were started. Check the DAZ log for missing component details.");
        stopBatch = true;
    }

    for (var rt = 0; rt < speechTargets.length && !stopBatch; rt += 1) {
        App.writeToLog("Nova v26 preview target " + (rt + 1) + "/" + speechTargets.length + ": " + speechTargets[rt].name, true);
        reviewAndRenderTarget(speechTargets[rt]);
    }

    // ============================================================

    // RESTORE FACIAL STATE

    // ============================================================

    for (var ri = 0; ri < savedProperties.length; ri += 1) {

        setPropertyValue(

            savedProperties[ri].property,

            savedProperties[ri].value

        );

    }

    // ============================================================

    // RESTORE ALPHA/ENVIRONMENT SETTINGS

    // ============================================================

    if (drawDome && oldDrawDome !== null) {

        setPropertyValue(drawDome, oldDrawDome);

    }

    if (drawGround && oldDrawGround !== null) {

        setPropertyValue(drawGround, oldDrawGround);

    }

    if (productionMaxSamplesProp && oldProductionMaxSamples !== null) {

        setPropertyValue(productionMaxSamplesProp, oldProductionMaxSamples);

    }

    if (productionMaxTimeProp && oldProductionMaxTime !== null) {

        setPropertyValue(productionMaxTimeProp, oldProductionMaxTime);

    }

    // ============================================================

    // RESTORE RENDER SETTINGS - SAME v8 EXIT/RESTORE SECTION

    // ============================================================

    try {

        renderOptions.imageSize = oldImageSize;

    } catch (eRestoreSize) {}

    try {

        renderOptions.isCurrentFrameRender = oldCurrentFrame;

    } catch (eRestoreFrame) {}

    try {

        renderOptions.renderImgToId = oldRenderImgTarget;

    } catch (eRestoreTarget) {}

    try {

        renderOptions.renderImgFilename = oldRenderImgFilename;

    } catch (eRestoreFilename) {}

    try {

        renderOptions.renderType = oldRenderType;

    } catch (eRestoreType) {}

    // ============================================================

    // RESTORE IRAY CPU/GPU - SAME v8 EXIT/RESTORE SECTION

    // ============================================================

    if (iraySchedulingEnabled) {

        try {

            if (

                typeof renderer.setCPULoadLimit == "function" &&

                oldCPULoadLimit >= 1.0

            ) {

                renderer.setCPULoadLimit(oldCPULoadLimit);

            }

            if (

                typeof renderer.setGPULoadLimit == "function" &&

                oldGPULoadLimit > 0

            ) {

                renderer.setGPULoadLimit(oldGPULoadLimit);

            }

            if (

                typeof renderer.setAllowCPUFallback == "function"

            ) {

                renderer.setAllowCPUFallback(oldAllowCPUFallback);

            }

            if (

                typeof renderer.setCPUThreadAffinityEnabled == "function"

            ) {

                renderer.setCPUThreadAffinityEnabled(oldCPUThreadAffinity);

            }

        } catch (eRestoreIray) {}

    }

    // ============================================================

    // WRITE COMPOSITOR MANIFEST

    // ============================================================

    var manifestPath = metadataDir.path() + "/nova_2_5d_manifest.json";

    try {

        var mf = new DzFile(manifestPath);

        if (mf.open(DzFile.WriteOnly | DzFile.Truncate | DzFile.Text)) {

            mf.writeLine("{");

            mf.writeLine('  "version": 24,');

            mf.writeLine('  "output_folder": "' + rootName + '",');

            mf.writeLine('  "canvas": {"width": 2048, "height": 2048},');

            mf.writeLine('  "facial_layer": {"width": 2048, "height": 2048, "scale": 1.0, "render_strategy": "normal_iray_render_with_facial_visibility_isolation"},');

            mf.writeLine('  "alpha": true,');

            mf.writeLine('  "mode": "interactive_composite_AEIOU_and_speech_shapes",');
            mf.writeLine('  "base": null,');
            mf.writeLine('  "notes": "Accepted AEIOU and speech family presets are combinations of real available morph controls; each is reviewed in the viewport before rendering.",');

            mf.writeLine('  "layers": {');
            mf.writeLine('    "eyes": {"path": "../eyes", "canvas": "2048x2048"},');
            mf.writeLine('    "blinks": {"path": "../blinks", "canvas": "2048x2048"},');
            mf.writeLine('    "eyebrows": {"path": "../eyebrows", "canvas": "2048x2048"},');
            mf.writeLine('    "mouth": {"path": "../mouth", "canvas": "2048x2048"},');
            mf.writeLine('    "face_deform": {"path": "../face_deform", "canvas": "2048x2048"},');
            mf.writeLine('    "vowels": {"path": "../vowels", "canvas": "2048x2048"},');
            mf.writeLine('    "speech": {"path": "../speech", "canvas": "2048x2048"},');
            mf.writeLine('    "expressions": {"path": "../expressions", "canvas": "2048x2048"},');
            mf.writeLine('    "emotions": {"path": "../emotions", "canvas": "2048x2048"},');
            mf.writeLine('    "reactions": {"path": "../reactions", "canvas": "2048x2048"},');
            mf.writeLine('    "idle_listening": {"path": "../idle_listening", "canvas": "2048x2048"},');
            mf.writeLine('    "transitions": {"path": "../transitions", "canvas": "2048x2048"}');
            mf.writeLine('  }');

            mf.writeLine('}');

            mf.close();

        } else {

            App.writeToLog("Nova v26 AEIOU + SPEECH: manifest could not be opened: " + manifestPath, true);

        }

    } catch (eManifest) {

        App.writeToLog("Nova v26 AEIOU + SPEECH: manifest write failed: " + eManifest, true);

    }

    // ============================================================

    // MANIFEST

    // ============================================================

    // DAZ's simple script file API varies between installations. Rather than

    // risk making the render pipeline fail, the manifest is logged and the

    // folder layout itself is the stable contract for the first compositor

    // test. A later pass can add JSON writing once the layer renders are

    // visually verified.

    App.writeToLog(

        "Nova v26 AEIOU + SPEECH manifest: root=" + rootPath,

        true

    );

    App.writeToLog(

        "Nova v26 AEIOU + SPEECH manifest: base=true, eyes=" +

        (eyeSide && eyeUpDown) +

        ", blinks=" +

        (!!eyeBlink) +

        ", eyebrows=" +

        browProperties.length +

        ", visemes=" +

        visemes.length +

        ", mouthDrivers=" +

        mouthDrivers.length +

        ", faceDeform=" +

        expressions.length +

        ", manifest=" + manifestPath,

        true

    );

    // ============================================================

    // COMPLETE - KEEP THE v8 EXIT/COMPLETION BEHAVIOR

    // ============================================================

    info(

        (stopBatch

            ? "NOVA AEIOU + SPEECH v26 STOPPED / EXITED\n\n"

            : "NOVA AEIOU + SPEECH v26 COMPLETE!\n\n") +

        "Rendered: " + rendered + "\n" +

        "Failed: " + failed + "\n" +

        "Eyebrow properties found: " + browProperties.length + "\n" +

        "Visemes found: " + visemes.length + "\n" +

        "Direct mouth/lip/jaw drivers found: " + mouthDrivers.length + "\n" +

        "AEIOU presets built: " + vowelsMade + "/5\n" +

        "Speech families built: " + phonemesMade + "/8\n" +

        "Face-deformation sources found: " + expressions.length + "\n" +

        "Alpha-ready environment handling: " +

        (alphaReady ? "YES" : "NO") +

        "\n\n" +

        "Output:\n" +

        rootPath + "\n\n" +

        (stopBatch ? "Exit requested; remaining shapes were cancelled.\n" : "All review targets have been processed.\n") +

        "The scene was not saved.\n" +

        "Facial morph values, render visibility, environment settings, render settings, and Iray scheduling were restored."

    );

}

novaMain();